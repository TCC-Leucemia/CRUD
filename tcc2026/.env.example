# Copie para tcc2026/.env e preencha com os valores locais.
# tcc2026/.env nunca é versionado (ver .gitignore).

# --- Banco de dados (MySQL local, driver mysql2) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=Todeschini
DB_PASSWORD=SUA_SENHA_LOCAL_AQUI
DB_NAME=tccof

# --- Autenticação (tokens JWT) ---
JWT_SECRET=SUA_CHAVE_JWT_AQUI

# --- E-mail (recuperação de senha) ---
EMAIL_USER=SEU_EMAIL_AQUI
EMAIL_PASS=SUA_SENHA_DE_APP_AQUI

# --- Análise por IA (backend/analise_celular.py) ---
OPENAI_API_KEY=SUA_CHAVE_OPENAI_AQUI
